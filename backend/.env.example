# ── Unstop credentials ────────────────────────────────────────────────────────
UNSTOP_EMAIL=your@email.com
UNSTOP_PASSWORD=yourpassword

# ── Google Calendar OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REFRESH_TOKEN=1//xxxx
GOOGLE_CALENDAR_ID=primary

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use local SQLite. On Railway/Render set this to the Postgres URL.
DATABASE_URL=sqlite:///./unstop_sync.db
